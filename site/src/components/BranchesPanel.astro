---
import { pageCopy } from '../data/plugins'
import type { Locale, RepoGraph } from '../lib/types'

interface Props {
  locale: Locale
  branches: RepoGraph['branches']
}

const { locale, branches } = Astro.props
const t = pageCopy
const zh = locale === 'zh'
---

<div class="branch-panel">
  <p class="branch-head">
    <span>{t.branchesTitle[locale]}</span>
    <span class="mono">{branches.length}</span>
  </p>
  <ul class="hairlines">
    {
      branches.map((branch) => (
        <li>
          <span class="branch-name mono">{branch.name}</span>
          {branch.current && <span class="tag tag-accent">{zh ? '当前' : 'current'}</span>}
          <span class="branch-upstream mono">{branch.upstream || (zh ? '无上游' : 'no upstream')}</span>
          <time class="mono" datetime={branch.date}>
            {branch.date}
          </time>
          <span class="branch-sha mono">{branch.short}</span>
        </li>
      ))
    }
  </ul>
  <p class="branch-note">{t.branchesNote[locale]}</p>
</div>

<style>
  .branch-panel {
    min-width: 0;
  }
  .branch-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin: 0 0 var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .branch-head .mono {
    color: var(--color-ink-2);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) auto minmax(0, 1.2fr) auto auto;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }
  .branch-name {
    color: var(--color-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .branch-upstream {
    color: var(--color-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .branch-sha {
    color: var(--color-muted);
  }
  li time {
    color: var(--color-muted);
  }
  .branch-note {
    margin: var(--space-xs) 0 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  @media (max-width: 40rem) {
    li {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2xs) var(--space-sm);
    }
    .branch-upstream,
    li time {
      grid-column: 1;
    }
    .branch-sha {
      grid-column: 2;
      grid-row: 1;
      text-align: end;
    }
  }
</style>
