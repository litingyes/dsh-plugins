---
import { context7Guidance } from '../data/plugins'
import type { Locale } from '../lib/types'

interface Props {
  locale: Locale
  prompt?: boolean
}

const { locale, prompt = true } = Astro.props
const guidance = context7Guidance
const zh = locale === 'zh'
const rows = [
  { action: zh ? '解析库 ID' : 'Resolve library', tool: 'resolve-library-id' },
  { action: zh ? '查询文档' : 'Query docs', tool: 'query-docs' },
]
---

<div class="ctx-rows">
  {
    rows.map((row) => (
      <div class="ctx-row">
        <img src="/icons/dsh-context7.svg" alt="" width="14" height="14" />
        <span class="ctx-title">Context7</span>
        <span class="ctx-sep" aria-hidden="true" />
        <span class="ctx-action">{row.action}</span>
        <span class="ctx-tool mono">{row.tool}</span>
      </div>
    ))
  }

  {
    prompt && (
      <div class="ctx-prompt">
        <p class="ctx-prompt-label">
          {zh ? '系统提示' : 'System prompt'}
          <span class="tag">{zh ? '节选' : 'excerpt'}</span>
        </p>
        <p class="ctx-prompt-text mono">{guidance.quote}</p>
      </div>
    )
  }
</div>

<style>
  .ctx-rows {
    min-width: 0;
  }
  .ctx-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    border-bottom: var(--rule-hair) solid var(--color-rule);
    min-width: 0;
  }
  .ctx-title {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .ctx-sep {
    width: 2px;
    height: 2px;
    border-radius: 1px;
    background: var(--color-rule-2);
    flex: 0 0 auto;
  }
  .ctx-action {
    color: var(--color-cool);
    font-size: var(--text-xs);
  }
  .ctx-tool {
    margin-inline-start: auto;
    color: var(--color-muted);
    font-size: 10.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ctx-prompt {
    padding: var(--space-md);
    background: var(--color-paper-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .ctx-prompt-label {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .ctx-prompt-text {
    margin: 0;
    color: var(--color-ink-2);
    font-size: 11.5px;
    line-height: 1.6;
    overflow-wrap: break-word;
  }
</style>
