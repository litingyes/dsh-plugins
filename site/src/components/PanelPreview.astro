---
import CommitGraph from './CommitGraph.astro'
import { siteCopy } from '../data/plugins'
import graphData from '../data/repo-graph.json'
import type { Locale, RepoGraph } from '../lib/types'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = siteCopy.home.hero
const graph = graphData as unknown as RepoGraph
const zh = locale === 'zh'
const branch = graph.source.currentBranch
---

<figure class="panel-figure">
  <div class="panel git-preview" data-slot="git-panel">
    <div class="preview-head">
      <img src="/icons/dsh-git.svg" alt="" width="18" height="18" />
      <span class="preview-title">{zh ? '工作区 Git' : 'Workspace Git'}</span>
      <span class="tag tag-mono">{branch}</span>
      <span class="preview-refresh" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M12 7a5 5 0 1 1-1.6-3.67M12 2v3.5H8.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>

    <div class="preview-tabs" aria-hidden="true">
      <span class="is-active">{zh ? '提交图' : 'Graph'}</span>
      <span>{zh ? '变更' : 'Changes'}</span>
      <span>{zh ? '分支' : 'Branches'}</span>
    </div>

    <div class="preview-scroll">
      <CommitGraph locale={locale} variant="panel" />
    </div>
  </div>

  <figcaption>
    <span class="preview-label">{t.panelLabel[locale]}</span>
    <span class="preview-note">{t.panelNote[locale]}</span>
  </figcaption>
</figure>

<style>
  .panel-figure {
    margin: 0;
    min-width: 0;
    justify-self: end;
    margin-inline-start: 0;
    width: 100%;
    max-width: 640px;
  }

  .git-preview {
    background: var(--color-paper-2);
    overflow: hidden;
    border-color: var(--color-rule-2);
  }

  .preview-head {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    border-bottom: var(--rule-hair) solid var(--color-rule);
    min-width: 0;
  }
  .preview-title {
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
  }
  .preview-head .tag {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .preview-refresh {
    margin-inline-start: auto;
    display: inline-flex;
    color: var(--color-muted);
  }

  .preview-tabs {
    display: flex;
    gap: var(--space-md);
    padding-inline: var(--space-md);
    border-bottom: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .preview-tabs span {
    padding-block: var(--space-sm);
    border-bottom: 2px solid transparent;
  }
  .preview-tabs .is-active {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }

  .preview-scroll {
    overflow: hidden;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-md);
    margin-top: var(--space-sm);
    padding-inline: var(--space-2xs);
  }
  .preview-label {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .preview-note {
    color: var(--color-muted);
    font-size: var(--text-xs);
    max-width: 46ch;
  }
</style>
