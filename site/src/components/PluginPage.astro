---
import Base from '../layouts/Base.astro'
import BranchesPanel from './BranchesPanel.astro'
import CommandBlock from './CommandBlock.astro'
import CommitGraph from './CommitGraph.astro'
import Context7Rows from './Context7Rows.astro'
import ToolTable from './ToolTable.astro'
import { context7Guidance, context7Story, manifest, pageCopy, siteCopy } from '../data/plugins'
import graphData from '../data/repo-graph.json'
import { url } from '../lib/i18n'
import type { Locale, PluginDoc, RepoGraph } from '../lib/types'

interface Props {
  locale: Locale
  plugin: PluginDoc
}

const { locale, plugin } = Astro.props
const t = pageCopy
const graph = graphData as unknown as RepoGraph
const zh = locale === 'zh'
const path = `plugins/${plugin.slug}`
const facts = manifest(plugin.slug)
const toolRows = plugin.tools.map((tool) => ({
  tool,
  from: { label: plugin.name[locale], href: url(locale, path), signal: plugin.signal },
}))
const story = context7Story
const guidance = context7Guidance
---

<Base
  locale={locale}
  path={path}
  title={`${plugin.name[locale]} | dsh-plugins`}
  description={plugin.summary[locale]}
>
  <article>
    <header class="section border-b border-rule plugin-header">
      <div class="wrap">
        <div class="grid-12 items-end">
          <div class="md:col-span-8">
            <div class="flex items-center gap-[var(--space-sm)]">
              <img src={plugin.icon} alt="" width="30" height="30" />
              <span class="mono text-[var(--text-xs)] text-muted">{plugin.packageName}</span>
            </div>
            <h1 class="page-title mt-[var(--space-md)]">{plugin.name[locale]}</h1>
            <p class="section-lead mt-[var(--space-md)]">
              {plugin.tagline[locale]}
              <span class="body-copy"> {plugin.summary[locale]}</span>
            </p>
            <dl class="header-facts mt-[var(--space-lg)]">
              <div>
                <dt>{locale === 'zh' ? '版本' : 'Version'}</dt>
                <dd class="mono">{facts.version}</dd>
              </div>
              <div>
                <dt>{locale === 'zh' ? '许可' : 'Licence'}</dt>
                <dd class="mono">MIT</dd>
              </div>
              {plugin.tools.length > 0 && (
                <div>
                  <dt>{locale === 'zh' ? '工具' : 'Tools'}</dt>
                  <dd class="mono">{plugin.tools.length}</dd>
                </div>
              )}
            </dl>
            <p class="header-spec">{plugin.runtime[locale]}</p>
          </div>
          <div class="md:col-span-4 md:text-end">
            <a class="link text-[var(--text-sm)]" href={plugin.readme}>{t.readme[locale]}</a>
          </div>
        </div>

        <div class="panel install-strip mt-[var(--space-xl)]">
          <div class="install-strip-grid">
            <div class="install-strip-main">
              <p class="card-label">{t.install[locale]}</p>
              <CommandBlock
                id={`install-${plugin.slug}`}
                locale={locale}
                label={plugin.packageName}
                command={plugin.install}
              />
              <p class="card-note">{plugin.installNote[locale]}</p>
            </div>
            <div class="install-strip-side">
              <p class="card-label">{t.requirements[locale]}</p>
              <ul class="req-list">
                {plugin.requirements.map((item) => <li>{item[locale]}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </header>

    {
      plugin.slug === 'dsh-git' && (
        <>
          <section class="section-wide">
            <div class="wrap">
              <div class="grid-12 items-end">
                <h2 class="md:col-span-6">{zh ? '提交图' : 'The commit graph'}</h2>
                <p class="section-lead md:col-span-5 md:col-start-8">{t.graphNote[locale]}</p>
              </div>
              <div class="mt-[var(--space-xl)]">
                <div class="panel overflow-hidden" data-slot="plugin-graph">
                  <CommitGraph locale={locale} toolbar />
                </div>
              </div>
            </div>
          </section>

          <section class="section">
            <div class="wrap grid-12 items-start">
              <div class="md:col-span-6">
                <h2>{t.features[locale]}</h2>
                <ul class="feature-list mt-[var(--space-lg)]">
                  {
                    plugin.features.map((feature) => (
                      <li>
                        <p class="feature-title">{feature.title[locale]}</p>
                        <p class="body-copy text-[var(--text-sm)]">{feature.body[locale]}</p>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class="md:col-span-6">
                <BranchesPanel locale={locale} branches={graph.branches} />
              </div>
            </div>
          </section>
        </>
      )
    }

    {
      plugin.slug === 'dsh-context7' && (
        <>
          <section class="section-wide">
            <div class="wrap">
              <div class="grid-12 items-end">
                <h2 class="md:col-span-6">{zh ? '两个工具' : 'Two tools'}</h2>
                <p class="section-lead md:col-span-5 md:col-start-8">
                  {zh
                    ? '解析库 ID，再按 ID 取文档；工具名由 serverName 加服务端原始名字组成。'
                    : 'Resolve an ID, then fetch docs by that ID. Names come from serverName plus the server’s own tool names.'}
                </p>
              </div>
              <div class="mt-[var(--space-xl)] well rounded-[var(--radius-card)] border border-rule p-[var(--space-lg)]">
                <ToolTable
                  locale={locale}
                  rows={toolRows}
                  cols={siteCopy.home.tools.cols}
                  caption={t.tools[locale]}
                />
              </div>
              <figure class="mt-[var(--space-xl)]">
                <div class="panel" data-slot="context7-rows">
                  <Context7Rows locale={locale} prompt={false} />
                </div>
                <figcaption class="body-copy mt-[var(--space-sm)] text-[var(--text-sm)]">
                  {zh
                    ? '对话里显示为 Context7 标志行，点开是请求参数与返回的文档。'
                    : 'In the conversation these appear as a Context7 mark row, expandable to the request and the returned documentation.'}
                </figcaption>
              </figure>
            </div>
          </section>

          <section class="section">
            <div class="wrap">
              <div class="grid-12 items-end">
                <h2 class="md:col-span-6">{story.title[locale]}</h2>
                <p class="section-lead md:col-span-5 md:col-start-8">{story.lead[locale]}</p>
              </div>

              <dl class="figures mt-[var(--space-xl)]">
                {
                  story.figures.map((figure) => (
                    <div>
                      <dt class="mono">{figure.label[locale]}</dt>
                      <dd class="mono figure-value">{figure.value}</dd>
                    </div>
                  ))
                }
              </dl>

              <div class="causes mt-[var(--space-2xl)] hairlines">
                {
                  story.causes.map((cause) => (
                    <div class="cause">
                      <h3>{cause.title[locale]}</h3>
                      <p class="body-copy text-[var(--text-sm)]">{cause.body[locale]}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          </section>

          <section class="section-wide">
            <div class="wrap grid-12 items-start">
              <div class="md:col-span-5">
                <h2>{guidance.title[locale]}</h2>
                <p class="section-lead mt-[var(--space-lg)]">{guidance.lead[locale]}</p>
                <ul class="guidance-facts mt-[var(--space-lg)]">
                  {guidance.facts.map((fact) => <li class="body-copy text-[var(--text-sm)]">{fact[locale]}</li>)}
                </ul>
              </div>
              <div class="md:col-span-7">
                <div class="panel prompt-panel">
                  <p class="card-label">
                    {zh ? '系统提示里的一段' : 'One paragraph in the system prompt'}
                    <span class="tag">{zh ? '节选' : 'excerpt'}</span>
                  </p>
                  <p class="prompt-text mono">{guidance.quote}</p>
                </div>
              </div>
            </div>
          </section>
        </>
      )
    }

    <section class="section border-t border-rule">
      <div class="wrap">
        <div class="grid-12 items-end">
          <h2 class="md:col-span-5">{t.config[locale]}</h2>
          <p class="section-lead md:col-span-6 md:col-start-7">
            {zh
              ? '写在 cordis.patch.yml 的挂载行里；覆盖这一行会整体替换 config，需要重述所有字段。'
              : 'Set on the mount row in cordis.patch.yml. Overriding the row replaces config wholesale, so restate every field.'}
          </p>
        </div>
        <div class="mt-[var(--space-xl)] overflow-x-auto">
          <table class="spec-table">
            <caption class="visually-hidden">{t.config[locale]}</caption>
            <thead>
              <tr>
                <th scope="col">{zh ? '字段' : 'Field'}</th>
                <th scope="col">{zh ? '默认' : 'Default'}</th>
                <th scope="col">{zh ? '说明' : 'Meaning'}</th>
              </tr>
            </thead>
            <tbody>
              {
                plugin.config.map((row) => (
                  <tr>
                    <td class="mono spec-field" data-label={zh ? '字段' : 'Field'}>
                      {row.field}
                    </td>
                    <td class="mono spec-value" data-label={zh ? '默认' : 'Default'}>
                      {row.value}
                    </td>
                    <td data-label={zh ? '说明' : 'Meaning'}>{row.desc[locale]}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {
      plugin.security.length > 0 && (
        <section class="section-wide">
          <div class="wrap">
            <div class="grid-12 items-end">
              <h2 class="md:col-span-5">{t.security[locale]}</h2>
            </div>
            <div class="panel mt-[var(--space-xl)] px-[var(--space-lg)]">
              <div class="hairlines">
                {plugin.security.map((item) => (
                  <p class="full-measure rule-row">{item[locale]}</p>
                ))}
              </div>
            </div>
          </div>
        </section>
      )
    }

    <section class="section border-t border-rule">
      <div class="wrap">
        <div class="grid-12 items-end">
          <h2 class="md:col-span-5">{t.limits[locale]}</h2>
        </div>
        <div class="panel mt-[var(--space-xl)] px-[var(--space-lg)]">
          <ul class="limits hairlines">
            {plugin.limits.map((item) => <li class="full-measure">{item[locale]}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .card-label {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .card-note {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.55;
  }
  .rule-top {
    margin-top: var(--space-sm);
    padding-top: var(--space-md);
  }
  .req-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    color: var(--color-ink-2);
    font-size: var(--text-xs);
    line-height: 1.55;
  }
  .req-list li {
    padding-inline-start: var(--space-sm);
    border-inline-start: var(--rule-hair) solid var(--color-rule-2);
  }

  .plugin-header {
    display: flex;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .plugin-header {
      min-height: min(700px, calc(100svh - var(--nav-h)));
    }
  }

  .header-spec {
    max-width: 74ch;
    margin: var(--space-xl) 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .header-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
  }
  .header-facts div {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }
  .header-facts dt {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .header-facts dd {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-sm);
  }

  .install-strip {
    padding: var(--space-xl);
  }
  .install-strip-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--gap-columns);
    align-items: start;
  }
  .install-strip-main,
  .install-strip-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }
  @media (max-width: 48rem) {
    .install-strip-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .feature-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .feature-title {
    margin: 0 0 var(--space-2xs);
    color: var(--color-ink);
    font-size: var(--text-md);
    font-weight: 500;
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-columns);
    margin: 0;
    padding-block: var(--space-lg);
    border-block: var(--rule-hair) solid var(--color-rule);
  }
  .figures > div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-xs);
    min-width: 0;
  }
  .figures dt {
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.5;
  }
  .figure-value {
    font-size: var(--text-display-s);
    line-height: 1;
    color: var(--color-ink);
    letter-spacing: var(--tracking-display);
  }

  .cause {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xs);
    padding-block: var(--space-lg);
  }
  @media (min-width: 48rem) {
    .cause {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--gap-columns);
      align-items: baseline;
    }
  }
  .cause h3 {
    max-width: none;
    font-size: var(--text-title);
    line-height: 1.25;
  }
  .cause p {
    margin: 0;
  }

  .guidance-facts {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .guidance-facts li {
    padding-inline-start: var(--space-md);
    border-inline-start: var(--rule-hair) solid var(--color-rule-2);
  }

  .prompt-panel {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .prompt-text {
    margin: 0;
    color: var(--color-ink-2);
    font-size: var(--text-xs);
    line-height: 1.7;
    overflow-wrap: break-word;
  }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: start;
    min-width: 640px;
  }
  .spec-table th {
    padding: var(--space-xs) var(--space-sm) var(--space-xs) 0;
    border-bottom: var(--rule-hair) solid var(--color-rule-2);
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 400;
    text-align: start;
  }
  .spec-table td {
    padding: var(--space-sm) var(--space-sm) var(--space-sm) 0;
    border-bottom: var(--rule-hair) solid var(--color-rule);
    vertical-align: baseline;
    color: var(--color-ink-2);
  }
  .spec-table tr:last-child td {
    border-bottom: 0;
  }
  .spec-field {
    color: var(--color-ink);
    white-space: nowrap;
  }
  .spec-value {
    color: var(--color-muted);
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .spec-table {
      min-width: 0;
    }
    .spec-table thead {
      display: none;
    }
    .spec-table,
    .spec-table tbody,
    .spec-table tr,
    .spec-table td {
      display: block;
      width: 100%;
    }
    .spec-table tr {
      padding-block: var(--space-md);
      border-bottom: var(--rule-hair) solid var(--color-rule);
    }
    .spec-table tr:last-child {
      border-bottom: 0;
    }
    .spec-table tr:last-child td {
      border-bottom: 0;
    }
    .spec-table td {
      display: grid;
      grid-template-columns: 6ch minmax(0, 1fr);
      gap: var(--space-xs);
      padding: var(--space-2xs) 0;
      border-bottom: 0;
      white-space: normal;
    }
    .spec-table td::before {
      content: attr(data-label);
      color: var(--color-muted);
      font-size: var(--text-xs);
    }
  }

  .rule-row {
    padding-block: var(--space-md);
  }
  .full-measure {
    max-width: none;
    margin: 0;
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .limits {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .limits li {
    padding-block: var(--space-sm);
  }
  .limits li:first-child {
    padding-top: 0;
  }

  @media (max-width: 48rem) {
    .figures {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
