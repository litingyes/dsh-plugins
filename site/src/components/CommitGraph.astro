---
import graphData from '../data/repo-graph.json'
import { pageCopy } from '../data/plugins'
import type { Locale, RepoGraph } from '../lib/types'

interface Props {
  locale: Locale
  variant?: 'panel' | 'full'
  toolbar?: boolean
}

const { locale, variant = 'full', toolbar = false } = Astro.props
const graph = graphData as unknown as RepoGraph
const t = pageCopy

const LANE_W = 16
const LANE_LEFT = 18
const ROW_H = 56
const CY = 28
const W = LANE_LEFT * 2 + (graph.layout.laneCount - 1) * LANE_W

const laneX = (lane: number) => LANE_LEFT + lane * LANE_W
const laneColor = (color: number) => `var(--lane-${(color % 8) + 1})`

const incoming = (row: (typeof graph.layout.rows)[number]) =>
  row.incoming.map((arc) => {
    const from = laneX(arc.from)
    const to = laneX(row.lane)
    return {
      d: `M${from} 0C${from} ${CY * 0.5} ${to} ${CY * 0.5} ${to} ${CY}`,
      color: laneColor(arc.color),
    }
  })
const outgoing = (row: (typeof graph.layout.rows)[number]) =>
  row.outgoing.map((arc) => {
    const from = laneX(row.lane)
    const to = laneX(arc.to)
    return {
      d: `M${from} ${CY}C${from} ${CY + (ROW_H - CY) * 0.45} ${to} ${CY + (ROW_H - CY) * 0.45} ${to} ${ROW_H}`,
      color: laneColor(arc.color),
    }
  })
const through = (row: (typeof graph.layout.rows)[number]) =>
  row.through.map((arc) => ({ d: `M${laneX(arc.lane)} 0V${ROW_H}`, color: laneColor(arc.color) }))

const visibleCommits = variant === 'panel' ? graph.commits.slice(0, 7) : graph.commits
const rows = visibleCommits.map((commit) => {
  const layoutRow = graph.layout.rows.find((candidate) => candidate.sha === commit.sha)
  return {
    commit,
    row: layoutRow!,
    detail: graph.details[commit.sha] ?? null,
  }
})

const shortDate = (date: string) => (variant === 'panel' ? date.slice(5) : date)
const refsFor = (commit: (typeof graph.commits)[number]) => {
  const limit = variant === 'panel' ? 2 : 3
  const local = commit.refs.filter((ref) => ref.kind !== 'remote')
  const ordered = commit.refs.filter((ref) => ref.kind === 'branch').concat(commit.refs.filter((ref) => ref.kind !== 'branch'))
  const pool = variant === 'panel' ? (local.length > 0 ? ordered.filter((ref) => ref.kind !== 'remote') : commit.refs) : ordered
  return pool.slice(0, limit)
}
const hiddenRefs = (commit: (typeof graph.commits)[number]) => {
  const pool = variant === 'panel' ? commit.refs.filter((ref) => ref.kind !== 'remote') : commit.refs
  return Math.max(0, pool.length - refsFor(commit).length)
}
const tabLabel = (zh: string, en: string) => (locale === 'zh' ? zh : en)

const fileStatus = (status: string) => {
  const names: Record<string, string> = {
    A: tabLabel('新增', 'added'),
    M: tabLabel('修改', 'modified'),
    D: tabLabel('删除', 'deleted'),
  }
  return names[status] ?? status
}
---

<div class:list={['commit-graph', variant === 'panel' ? 'is-panel' : 'is-full']} data-commit-graph>
  {
    toolbar && (
      <div class="graph-toolbar" data-graph-toolbar>
        <div class="graph-search">
          <label class="visually-hidden" for={`graph-search-${locale}`}>
            {t.graphSearch[locale]}
          </label>
          <input
            id={`graph-search-${locale}`}
            type="search"
            data-graph-search
            placeholder={t.graphSearch[locale]}
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <button type="button" class="btn btn-quiet btn-small" data-graph-toggle aria-pressed="false">
          {t.graphFilterAll[locale]}
        </button>
        <p class="graph-count mono" aria-live="polite">
          <span data-graph-count>{rows.length}</span>
          <span>{t.graphCount[locale]}</span>
        </p>
      </div>
    )
  }

  <div class="graph-body">
    {
      rows.map(({ commit, row, detail }) => {
        const search = `${commit.subject} ${commit.author} ${commit.sha}`.toLowerCase()
        return (
          <details
            class="commit"
            data-commit
            data-on-current={commit.onCurrent ? '1' : '0'}
            data-search={search}
          >
            <summary class="commit-summary">
              <span class="commit-lanes" aria-hidden="true">
                <svg
                  width={W}
                  height={ROW_H}
                  viewBox={`0 0 ${W} ${ROW_H}`}
                  fill="none"
                  stroke-linecap="round"
                >
                  {through(row).map((seg) => (
                    <path d={seg.d} stroke={seg.color} stroke-width="1.5" opacity="0.85" />
                  ))}
                  {incoming(row).map((seg) => (
                    <path d={seg.d} stroke={seg.color} stroke-width="1.5" opacity="0.85" />
                  ))}
                  {outgoing(row).map((seg) => (
                    <path d={seg.d} stroke={seg.color} stroke-width="1.5" opacity="0.85" />
                  ))}
                  <circle cx={laneX(row.lane)} cy={CY} r="6" fill="var(--color-paper-2)" />
                  <circle cx={laneX(row.lane)} cy={CY} r="3.6" fill={laneColor(row.color)} />
                </svg>
              </span>

              <span class="commit-main">
                <span class="commit-subject">{commit.subject}</span>
                <span class="commit-meta">
                  <span class="commit-refs">
                    {refsFor(commit).map((ref) => (
                      <span
                        class:list={[
                          'tag',
                          'tag-mono',
                          ref.kind === 'tag' && 'tag-accent',
                          ref.kind === 'remote' && 'is-remote',
                        ]}
                      >
                        {ref.name}
                      </span>
                    ))}
                    {hiddenRefs(commit) > 0 && <span class="tag">+{hiddenRefs(commit)}</span>}
                  </span>
                  <span class="commit-facts mono">
                    <span class="commit-author">{commit.author}</span>
                    <span>{shortDate(commit.date)}</span>
                    <span>{commit.sha.slice(0, 7)}</span>
                  </span>
                </span>
              </span>

              <span class="commit-chevron" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </summary>

            {variant !== 'panel' && (
            <div class="commit-detail">
              <p class="commit-message">{detail ? detail.message : commit.subject}</p>

              <dl class="commit-facts-grid">
                <div>
                  <dt>{tabLabel('作者', 'Author')}</dt>
                  <dd class="mono is-person">{detail ? detail.author.name : commit.author}</dd>
                </div>
                <div>
                  <dt>{tabLabel('提交时间', 'Committed')}</dt>
                  <dd class="mono">{detail ? detail.committedAt.slice(0, 16).replace('T', ' ') : commit.date}</dd>
                </div>
                <div>
                  <dt>{tabLabel('父提交', 'Parents')}</dt>
                  <dd class="mono">{commit.parents.length > 0 ? commit.parents.map((p) => p.slice(0, 7)).join(' ') : '—'}</dd>
                </div>
                <div>
                  <dt>refs</dt>
                  <dd class="mono">{commit.refs.length > 0 ? commit.refs.map((ref) => ref.name).join(', ') : '—'}</dd>
                </div>
              </dl>

              {detail && detail.files.length > 0 && (
                <div class="commit-files">
                  <p class="commit-detail-title">
                    {detail.files.length}
                    {tabLabel(' 个文件变更', ' files changed')}
                    {detail.filesTruncated ? tabLabel('（截断）', ' (truncated)') : ''}
                  </p>
                  <ul>
                    {detail.files.slice(0, variant === 'panel' ? 5 : 10).map((file) => (
                      <li>
                        <span class:list={['file-status', `is-${file.status.toLowerCase()}`]} title={fileStatus(file.status)}>
                          {file.status}
                        </span>
                        <span class="file-path mono">{file.path}</span>
                        <span class="file-count mono">
                          <span class="is-added">+{file.added}</span>
                          <span class="is-deleted">-{file.deleted}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {detail?.diff && (
                <div class="commit-diff">
                  <p class="commit-detail-title">
                    {tabLabel('补丁', 'Patch')} <span class="mono">{detail.diff.path}</span>
                  </p>
                  <pre class="code diff"><code>{detail.diff.lines.map((line) => (
                    <span class:list={['diff-line', line.startsWith('+') && 'is-added', line.startsWith('-') && 'is-deleted', line.startsWith('@@') && 'is-hunk']}>{line}</span>
                  ))}</code></pre>
                </div>
              )}
            </div>
            )}
          </details>
        )
      })
    }
  </div>
</div>

<script>
  for (const root of document.querySelectorAll('[data-commit-graph]')) {
    const input = root.querySelector('[data-graph-search]')
    const toggle = root.querySelector('[data-graph-toggle]')
    const counter = root.querySelector('[data-graph-count]')
    if (!input || !toggle || !counter) continue

    const items = Array.from(root.querySelectorAll('details[data-commit]'))
    let currentOnly = false

    const apply = () => {
      const query = input.value.trim().toLowerCase()
      let shown = 0
      for (const item of items) {
        const matchesQuery = query === '' || (item.getAttribute('data-search') ?? '').includes(query)
        const matchesBranch = !currentOnly || item.getAttribute('data-on-current') === '1'
        const visible = matchesQuery && matchesBranch
        if (visible) shown += 1
        item.hidden = !visible
      }
      counter.textContent = String(shown)
    }

    input.addEventListener('input', apply)
    toggle.addEventListener('click', () => {
      currentOnly = !currentOnly
      toggle.setAttribute('aria-pressed', String(currentOnly))
      toggle.textContent = currentOnly
        ? (document.documentElement.lang.startsWith('zh') ? '仅当前分支' : 'Current branch')
        : (document.documentElement.lang.startsWith('zh') ? '全部分支' : 'All branches')
      apply()
    })
    apply()
  }
</script>

<style>
  .commit-graph {
    min-width: 0;
    font-size: var(--text-sm);
  }

  .graph-toolbar {
    display: none;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  :global(html[data-js='on']) .graph-toolbar {
    display: flex;
  }

  .graph-search {
    flex: 1 1 auto;
    min-width: 0;
  }
  .graph-search input {
    width: 100%;
    height: 44px;
    padding-inline: var(--space-sm);
    border: var(--rule-hair) solid var(--color-muted);
    border-radius: var(--radius-pill);
    background: var(--color-paper-3);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-sm);
    outline: none;
  }
  .graph-search input::placeholder {
    color: var(--color-muted);
  }
  .graph-search input:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }

  .graph-count {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .graph-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .commit {
    border-bottom: var(--rule-hair) solid var(--color-rule);
    min-width: 0;
  }
  .commit:last-child {
    border-bottom: 0;
  }
  .commit[hidden] {
    display: none;
  }

  .commit-summary {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 56px;
    padding: var(--space-2xs) var(--space-md) var(--space-2xs) 0;
    cursor: pointer;
    list-style: none;
    min-width: 0;
  }
  .commit-summary::-webkit-details-marker {
    display: none;
  }
  .commit-summary:hover .commit-subject {
    color: var(--color-accent);
  }
  .commit-summary:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  .commit-lanes {
    flex: 0 0 auto;
    display: block;
    width: 52px;
  }
  .commit-lanes svg {
    display: block;
    max-width: none;
  }

  .commit-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    flex: 1 1 auto;
    min-width: 0;
    padding-block: var(--space-xs);
  }

  .commit-subject {
    color: var(--color-ink);
    font-size: var(--text-sm);
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    transition: color var(--dur-micro) var(--ease-out);
  }

  .commit-meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
    overflow: hidden;
  }

  .commit-refs {
    display: inline-flex;
    gap: var(--space-2xs);
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
  }
  .commit-refs .tag {
    max-width: 152px;
    padding-inline: var(--space-2xs) var(--space-xs);
    font-size: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .commit-refs :global(.is-remote) {
    color: var(--color-muted);
  }

  .commit-facts {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-xs);
    flex: 0 0 auto;
    color: var(--color-muted);
    font-size: 11px;
    white-space: nowrap;
  }

  .commit-chevron {
    flex: 0 0 auto;
    display: inline-flex;
    color: var(--color-muted);
    transition: transform var(--dur-micro) var(--ease-out);
  }
  .commit[open] .commit-chevron {
    transform: rotate(90deg);
  }

  .commit-detail {
    padding: 0 var(--space-md) var(--space-lg) var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-width: 0;
  }

  .commit-message {
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-pill);
    background: var(--color-paper-3);
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  .commit-facts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm) var(--space-lg);
    margin: 0;
  }
  .commit-facts-grid div {
    min-width: 0;
  }
  .commit-facts-grid dt {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .commit-facts-grid dd {
    margin: 0;
    color: var(--color-ink-2);
    font-size: var(--text-xs);
    overflow-wrap: break-word;
  }
  .commit-facts-grid .is-person {
    color: var(--color-accent);
  }

  .commit-detail-title {
    margin: 0 0 var(--space-xs);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .commit-detail-title .mono {
    color: var(--color-ink-2);
  }

  .commit-files ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .commit-files li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-2xs) var(--space-sm);
    min-width: 0;
  }
  .commit-files li + li {
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .file-status {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: var(--color-paper-3);
    color: var(--color-ink-2);
    font-family: var(--font-outlier);
    font-size: 10px;
    font-weight: 500;
  }
  .file-status.is-a {
    color: var(--color-ok);
  }
  .file-status.is-d {
    color: var(--color-bad);
  }

  .file-path {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-ink-2);
    font-size: var(--text-xs);
  }

  .file-count {
    flex: 0 0 auto;
    display: inline-flex;
    gap: var(--space-xs);
    font-size: var(--text-xs);
  }
  .file-count .is-added {
    color: var(--color-ok);
  }
  .file-count .is-deleted {
    color: var(--color-bad);
  }

  .commit-diff .code {
    max-height: 220px;
    overflow: auto;
    padding: var(--space-sm);
    font-size: var(--text-xs);
    line-height: 1.5;
  }
  .diff {
    white-space: pre;
  }
  .diff-line {
    display: block;
    color: var(--color-ink-2);
  }
  .diff-line.is-added {
    color: var(--color-ok);
  }
  .diff-line.is-deleted {
    color: var(--color-bad);
  }
  .diff-line.is-hunk {
    color: var(--color-cool);
  }

  .is-panel .commit-summary {
    min-height: 52px;
    padding-right: var(--space-sm);
    cursor: default;
    pointer-events: none;
  }
  .is-panel .commit-chevron {
    display: none;
  }
  .is-panel .commit-lanes {
    width: 44px;
    transform: scale(0.9);
    transform-origin: left center;
  }
  .is-panel .commit-subject {
    font-size: var(--text-xs);
  }
  .is-panel .commit-author {
    display: none;
  }
  .is-panel .commit-meta {
    gap: var(--space-2xs);
  }
  .is-panel .commit-detail {
    padding-left: var(--space-md);
    padding-bottom: var(--space-md);
  }
  .is-panel .commit-files li {
    padding-inline: var(--space-xs);
  }
</style>
