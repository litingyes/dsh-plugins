          "index 3e18a45..e2b8e50 100644",
          "--- a/site/src/components/PluginIndex.astro",
          "+++ b/site/src/components/PluginIndex.astro",
          "@@ -1,3 +1,3 @@",
          " ---",
          "-import { plugins, pageCopy, siteCopy } from '../data/plugins'",
          "+import { manifest, plugins, pageCopy, siteCopy } from '../data/plugins'",
          " import { url } from '../lib/i18n'",
          "@@ -25,6 +25,11 @@ const repo = siteCopy.home.index.repoRow",
          "         <div class=\"plugin-facts\">",
          "-          <span class=\"tag\">",
