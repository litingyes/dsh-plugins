          "-            {locale === 'zh' ? ' 个工具' : ' tools'}",
          "-          </span>",
          "+          <span class=\"tag tag-mono\">{manifest(plugin.slug).version}</span>",
          "+          {",
          "+            plugin.tools.length > 0 && (",
          "+              <span class=\"tag\">",
          "+                {plugin.tools.length}"
        ],
        "truncated": true
      }
