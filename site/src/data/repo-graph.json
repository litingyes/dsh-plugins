  "details": {
    "fac38bfd7a7c7f4137abb5ae2af931ba3d48bab2": {
      "message": "build(git): assert the committed client.js is fresh\n\n`npm run check` validated only syntax, so a version bump that never rebuilt\nthe browser half shipped a bundle whose banner disagreed with package.json.\nThat is exactly how 0.5.1's tagged tree ended up stale while CI published a\nfresh build.\n\n`node scripts/build-client.mjs --check` rebuilds in memory and fails on any\nbyte difference; `check` now runs it before the syntax passes.\n`prepublishOnly` already builds first, so CI is unaffected.",
      "author": {
        "name": "litingyes",
        "email": "luz.liting@gmail.com"
      },
      "committer": {
        "name": "litingyes",
        "email": "luz.liting@gmail.com"
      },
      "committedAt": "2026-11-07T12:55:29+08:00",
      "files": [
        {
          "path": "dsh-git/package.json",
          "status": "M",
          "added": 1,
          "deleted": 1,
          "binary": false
        },
        {
          "path": "dsh-git/scripts/build-client.mjs",
          "status": "M",
          "added": 36,
          "deleted": 6,
          "binary": false
        }
      ],
      "filesTruncated": false,
      "diff": {
        "path": "dsh-git/package.json",
        "lines": [
          "diff --git a/dsh-git/package.json b/dsh-git/package.json",
          "index 4864c35..bc83fd6 100644",
          "--- a/dsh-git/package.json",
          "+++ b/dsh-git/package.json",
          "@@ -77,3 +77,3 @@",
