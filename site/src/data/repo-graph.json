    "f9d31c39ee7948b5ea9e86ea5bc7a231e228962b": {
      "message": "feat(git): switch branches from the composer status row\n\nAdd a branch chip to the composer status dock: current branch, detached short SHA, an uncommitted-changes dot, a filterable local-branch picker, and create-and-switch.\n\nShare one per-directory snapshot between the chip and the right-sidebar panel, and move the panel onto that store so a switch in either surface updates the other.\n\nRender the picker with the host menu material, and resolve the active language from the locale snapshot's active field so the plugin follows the app language.\n\nBump the package to 0.4.0, rebuild the browser half, and document the new surface.",
      "author": {
        "name": "litingyes",
        "email": "luz.liting@gmail.com"
      },
